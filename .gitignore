# Never commit secrets or backups
.zshrc.secrets
*.bak
*.bak.*

# Karabiner rewrites its own config directory (which we symlink whole, see
# bootstrap.sh) and drops a timestamped copy here on every GUI change.
macos/karabiner/automatic_backups/

# Generated by macos/aerospace/apply-layout.py from aerospace.base.toml plus a
# layout-*.toml fragment. The sources are tracked; the merge result is not.
macos/aerospace/aerospace.toml
