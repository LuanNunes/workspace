# Never commit secrets or backups
.zshrc.secrets
*.bak
*.bak.*

# Karabiner rewrites its own config directory (which we symlink whole, see
# bootstrap.sh) and drops a timestamped copy here on every GUI change.
macos/karabiner/automatic_backups/

# Generated by macos/aerospace/apply-layout.py from aerospace.base.toml plus a
# layout-*.toml fragment. The sources are tracked; the merge result is not.
macos/aerospace/aerospace.toml

# Compiled by macos/bootstrap.sh (step `displaywatch`) from display-watch.swift.
# A Mach-O binary has no business in a dotfiles repo, and it would be the wrong
# architecture on half the machines that clone it. The source is tracked.
macos/aerospace/display-watch

# CPython drops these next to any module it imports. apply-layout.py is run as a
# script, so it normally leaves none — one appears the moment anything imports
# it, which is what a test or an interactive session does.
__pycache__/
