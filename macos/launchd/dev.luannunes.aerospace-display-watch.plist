<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.luannunes.aerospace-display-watch</string>

    <!--
      Run through /bin/sh ONLY to get $HOME expanded. launchd does not expand ~
      or $HOME inside ProgramArguments, so a direct invocation would have to
      hardcode /Users/<name> and this file would stop being portable. `exec`
      keeps it a single process instead of leaving a shell as the parent, so
      KeepAlive below watches the watcher and not a wrapper.

      Both paths are the symlinks bootstrap.sh creates in ~/.config/aerospace,
      which is why nothing here mentions where the repo is checked out.
    -->
    <!--
      The redirect is here, in the shell, and NOT in StandardOutPath below — for
      the same reason the paths are: launchd expands neither ~ nor $HOME in
      those keys, and this file must not hardcode /Users/<name>.

      It used to point at /tmp for exactly that reason, and that cost a
      diagnosis. apply-layout.py's output is the only record of what happened
      while you were not looking, and macOS empties /tmp — a reboot on
      2026-09-10 took the whole history of a three-monitor session with it,
      leaving one line written after the machine came back up. A log that does
      not survive the crash you are investigating is not a log.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "$HOME/.config/aerospace/display-watch" "$HOME/.config/aerospace/apply-layout.py" >>"$HOME/Library/Logs/aerospace-display-watch.log" 2>&amp;1</string>
    </array>

    <!-- RunAtLoad starts it at login; the binary itself waits 10s before its
         first run so AeroSpace's server is up to be asked. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- It is a daemon that should never exit. If it does, bring it back. -->
    <key>KeepAlive</key>
    <true/>

    <!-- No StandardOutPath / StandardErrorPath: the shell redirect above sends
         both streams to one file, so the ordering is real and the path can be
         written relative to $HOME.
             tail -f ~/Library/Logs/aerospace-display-watch.log -->

</dict>
</plist>
